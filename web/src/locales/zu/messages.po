msgstr "Awunakho ukufinyelela kunoma yimaphi amasizinda."

#. placeholder {0}: providerName(identity.provider)
#: src/features/user/login.tsx
msgid "You won't be able to sign in with {0} anymore. Make sure you still have another way to log in."
msgstr "Ngeke usakwazi ukungena ngo-{0}. Qiniseka ukuthi usenazo ezinye izindlela zokungena."

#: ../../../lib/web/src/components/restore-banner.tsx
msgid "Your account was moved here from {source}. Until you delete it there, messages and notifications may reach both servers, some of your content keeps being served from the old server, and followers may take a few minutes to find you here."
msgstr "I-akhawunti yakho isuswe lapha ivela ku-{source}. Uze uyisuse lapho, imilayezo nezaziso zingafika eziservereni zombili, ingxenye yomqukathi wakho iqhubeka inikezwa eservereni endala, futhi abalandeli bangathatha imizuzu embalwa ukukuthola lapha."

#: src/features/user/close-account.tsx
msgid "Your account will be permanently deleted on {purgeDate}. You've been signed out. To cancel, sign in again before then."
msgstr "I-akhawunti yakho izosuswa unomphela ngo-{purgeDate}. Uphumile. Ukuze ukhansele, ngena futhi ngaphambi kwalokho."

#: src/features/user/close-account.tsx
msgid "Your account will be scheduled for deletion and you'll be signed out. You can cancel any time before the deletion date by logging back in. Download your data first if you want to keep a copy."
msgstr "I-akhawunti yakho izohlelelwa ukususwa futhi uzophuma. Ungakhansela noma nini ngaphambi kosuku lokususwa ngokungena kabusha. Landa idatha yakho kuqala uma ufuna ukugcina ikhophi."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your attachments will be lost."
msgstr "Okunamathiselwe kwakho kuzolahleka."

#: src/features/user/data.tsx
msgid "Your data"
msgstr "Idatha yakho"

#: src/features/user/data.tsx
msgid "Your data is downloading"
msgstr "Idatha yakho iyalandwa"

#: src/features/user/data.tsx
msgid "Your private keys are included, encrypted with this passphrase. Store it safely. You'll need it to restore."
msgstr "Izihluthulelo zakho eziyimfihlo zifakiwe, zikhiyelwe nale mshwana wephasiwedi. Gcina ngokuphepha. Uzidinga ukuze ubuyisele."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your text and attachments will be lost."
msgstr "Umbhalo nokunamathiselwe kwakho kuzolahleka."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your text will be lost."
msgstr "Umbhalo wakho uzolahleka."
